# Copy to .env — works as-is for a local run on http://localhost:8000.
# Anything left empty is simply disabled (payments, OAuth, captcha, Telegram, mail).

# --- Compose ---------------------------------------------------------------
WEB_PORT=8000
# Full production stack: workers,bot,mail
COMPOSE_PROFILES=

# --- Django ----------------------------------------------------------------
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:8000
SHOP_CURRENCY=USD

# Behind an HTTPS reverse proxy (nginx, aaPanel, Cloudflare):
# USE_X_FORWARDED_HOST=True
# TRUST_X_FORWARDED_PROTO=True

# --- PostgreSQL / Redis ----------------------------------------------------
DB_ENGINE=postgres
POSTGRES_DB=freestore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
CELERY_BROKER_URL=redis://redis:6379/0
# Run tasks inline; set False when the `workers` profile is on
CELERY_TASK_ALWAYS_EAGER=True

# --- Email -----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL="Freestore <no-reply@example.com>"
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST= / EMAIL_PORT=587 / EMAIL_HOST_USER= / EMAIL_HOST_PASSWORD=
# MAILSERVER_OVERRIDE_HOSTNAME=mail.example.com

# --- Payments --------------------------------------------------------------
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
ROLLYPAY_TERMINAL_ID=
ENOT_SHOP_ID=
ENOT_API_KEY=
ENOT_WEBHOOK_SECRET=

# --- Sign-in & anti-bot ----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Telegram bot (`bot` profile) ------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BOT_INTERNAL_API_KEY=change-me
BOT_INTERNAL_API_BASE_URL=http://telegram-bot:8091
TG_FORUM_CHAT_ID=

# --- Monitoring ------------------------------------------------------------
SENTRY_DSN=
